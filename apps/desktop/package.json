{
  "name": "peanut-browsing-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Peanut Browsing browser client",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac dmg zip",
    "package:win": "electron-builder --win nsis",
    "package:linux": "electron-builder --linux AppImage",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.japstudios.peanutbrowsing",
    "productName": "Peanut Browsing",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "cross-fetch": "^4.1.0",
    "ipaddr.js": "^2.2.0"
  }
}
