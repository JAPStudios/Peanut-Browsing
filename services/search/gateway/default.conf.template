map $http_x_api_key $peanut_search_key_valid {
    default 0;
    "${PEANUT_SEARCH_API_KEY}" 1;
}

limit_req_zone $server_name zone=peanut_search:10m rate=2r/s;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 8k;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /index/search {
        if ($peanut_search_key_valid = 0) {
            return 401;
        }

        limit_req zone=peanut_search burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://index:8081/search;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }

    location = /index/crawl {
        if ($peanut_search_key_valid = 0) {
            return 401;
        }

        limit_req zone=peanut_search burst=2 nodelay;
        limit_req_status 429;
        limit_except POST {
            deny all;
        }

        proxy_pass http://index:8081/crawl;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }

    location / {
        return 404;
    }
}
