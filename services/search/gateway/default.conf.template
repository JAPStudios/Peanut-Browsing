map $http_x_api_key $peanut_search_key_valid {
    default 0;
    "${PEANUT_SEARCH_API_KEY}" 1;
}

# A conservative shared limit protects the initial single-key gateway.
# Tune this after observing real traffic and the upstream provider limits.
limit_req_zone $server_name zone=peanut_search:10m rate=2r/s;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1k;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /search {
        if ($peanut_search_key_valid = 0) {
            return 401;
        }

        limit_req zone=peanut_search burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://core:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / {
        return 404;
    }
}
