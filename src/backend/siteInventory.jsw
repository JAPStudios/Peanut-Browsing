import { fetch } from 'wix-fetch';

const MAX_SITEMAPS = 10;
const MAX_PAGES = 1000;
const MAX_XML_CHARS = 2 * 1024 * 1024;
const MAX_ROBOTS_CHARS = 512 * 1024;

function reject(message) {
    throw new Error(message);
}

function publicHttpUrl(value) {
    if (typeof value !== 'string' || value.length > 2048) reject('Enter a valid website address.');
    let url;
    try {
        url = new URL(value.trim());
    } catch (error) {
        reject('Enter a valid website address.');
    }
    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
        reject('Only credential-free HTTP and HTTPS addresses are supported.');
    }
    const host = url.hostname.toLowerCase().replace(/^\[|\]$/g, '');
    const blocked = host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local') ||
        host === '::1' || host.startsWith('fc') || host.startsWith('fd') || host.startsWith('fe80:') ||
        /^127\./.test(host) || /^10\./.test(host) || /^192\.168\./.test(host) ||
        /^169\.254\./.test(host) || /^172\.(1[6-9]|2[0-9]|3[01])\./.test(host) || /^0\./.test(host);
    if (blocked) reject('Private, local and loopback network addresses cannot be imported.');
    url.hash = '';
    return url;
}

function decodeXml(value) {
    return value.replace(/&amp;/gi, '&').replace(/&quot;/gi, '"')
        .replace(/&apos;|&#39;/gi, "'").replace(/&lt;/gi, '<')
        .replace(/&gt;/gi, '>').replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
        .replace(/&#x([\da-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)));
}

function extractLocations(xml) {
    const locations = [];
    const pattern = /<(?:[\w.-]+:)?loc\b[^>]*>([\s\S]*?)<\/(?:[\w.-]+:)?loc\s*>/gi;
    let match;
    while ((match = pattern.exec(xml)) && locations.length < MAX_PAGES) {
        const value = decodeXml(match[1].replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1').trim());
        if (value) locations.push(value);
    }
    return locations;
}

async function readText(url, maxChars, acceptedType) {
    let response;
    try {
        response = await fetch(url.href, {
            method: 'get',
            headers: { Accept: acceptedType },
            redirect: 'manual'
        });
    } catch (error) {
        return { status: 'unreachable' };
    }
    if (response.status >= 300 && response.status < 400) {
        return { status: 'redirect' };
    }
    if (!response.ok) return { status: 'http-error', httpStatus: response.status };
    const contentType = response.headers.get('content-type') || '';
    if (!acceptedType.split(',').some(type => contentType.toLowerCase().includes(type.trim().split(';')[0]))) {
        return { status: 'unsupported-content-type', contentType };
    }
    const length = Number(response.headers.get('content-length') || 0);
    if (length > maxChars) return { status: 'too-large' };
    const text = await response.text();
    if (text.length > maxChars) return { status: 'too-large' };
    return { status: 'ok', text };
}

/**
 * Builds a bounded, read-only inventory from a site's robots.txt and XML sitemaps.
 * It does not download page bodies, copy content, or publish changes.
 */
export async function previewWebsiteInventory(address) {
    const origin = publicHttpUrl(address);
    const robotsUrl = new URL('/robots.txt', origin);
    const robots = await readText(robotsUrl, MAX_ROBOTS_CHARS, 'text/plain');

    const sitemapQueue = [];
    if (robots.status === 'ok') {
        const lines = robots.text.split(/\r?\n/);
        for (const line of lines) {
            const match = line.match(/^\s*sitemap\s*:\s*(\S+)/i);
            if (!match) continue;
            try {
                const sitemapUrl = publicHttpUrl(new URL(match[1], origin).href);
                if (sitemapUrl.origin === origin.origin && !sitemapQueue.includes(sitemapUrl.href)) {
                    sitemapQueue.push(sitemapUrl.href);
                }
            } catch (error) {
                // Invalid sitemap declarations are ignored.
            }
        }
    }
    if (sitemapQueue.length === 0) sitemapQueue.push(new URL('/sitemap.xml', origin).href);

    const visitedSitemaps = new Set();
    const pageUrls = new Set();
    const warnings = [];
    while (sitemapQueue.length > 0 && visitedSitemaps.size < MAX_SITEMAPS && pageUrls.size < MAX_PAGES) {
        const sitemapAddress = sitemapQueue.shift();
        if (visitedSitemaps.has(sitemapAddress)) continue;
        visitedSitemaps.add(sitemapAddress);

        let sitemapUrl;
        try {
            sitemapUrl = publicHttpUrl(sitemapAddress);
        } catch (error) {
            warnings.push('An invalid sitemap address was skipped.');
            continue;
        }
        if (sitemapUrl.origin !== origin.origin) {
            warnings.push('A sitemap outside the submitted website was skipped.');
            continue;
        }

        const document = await readText(sitemapUrl, MAX_XML_CHARS, 'application/xml,text/xml,application/x-gzip');
        if (document.status !== 'ok') {
            warnings.push('A sitemap could not be read: ' + sitemapUrl.pathname);
            continue;
        }

        const isIndex = /<(?:[\w.-]+:)?sitemapindex\b/i.test(document.text);
        const locations = extractLocations(document.text);
        for (const location of locations) {
            if (pageUrls.size >= MAX_PAGES) break;
            try {
                const resolved = publicHttpUrl(new URL(location, sitemapUrl).href);
                if (resolved.origin !== origin.origin) continue;
                if (isIndex) {
                    if (sitemapQueue.length + visitedSitemaps.size < MAX_SITEMAPS &&
                        !visitedSitemaps.has(resolved.href) && !sitemapQueue.includes(resolved.href)) {
                        sitemapQueue.push(resolved.href);
                    }
                } else {
                    pageUrls.add(resolved.href);
                }
            } catch (error) {
                // Invalid or disallowed locations are excluded.
            }
        }
    }

    if (sitemapQueue.length > 0) warnings.push('The sitemap limit was reached before every sitemap could be checked.');
    if (pageUrls.size >= MAX_PAGES) warnings.push('The page inventory reached its configured limit.');

    return {
        status: pageUrls.size > 0 ? 'inventory' : 'no-sitemap-pages',
        websiteUrl: origin.origin,
        robotsStatus: robots.status,
        sitemapsChecked: visitedSitemaps.size,
        pageCount: pageUrls.size,
        pages: Array.from(pageUrls),
        limits: { maxSitemaps: MAX_SITEMAPS, maxPages: MAX_PAGES },
        warnings,
        message: 'This is a read-only sitemap inventory. No page content has been copied, stored or published.'
    };
}
