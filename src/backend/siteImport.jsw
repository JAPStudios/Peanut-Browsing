import { fetch } from 'wix-fetch';

const MAX_HTML_BYTES = 2 * 1024 * 1024;
const MAX_LINKS = 200;
const REQUEST_TIMEOUT_MS = 15000;

function fail(message) {
    throw new Error(message);
}

function validatePublicHttpUrl(input) {
    if (typeof input !== 'string' || input.length > 2048) {
        fail('Enter a valid website address.');
    }

    let url;
    try {
        url = new URL(input.trim());
    } catch (error) {
        fail('Enter a valid website address.');
    }

    if (!['http:', 'https:'].includes(url.protocol)) {
        fail('Only HTTP and HTTPS website addresses are supported.');
    }

    if (url.username || url.password) {
        fail('Website addresses containing embedded credentials are not supported.');
    }

    const host = url.hostname.toLowerCase().replace(/^\[|\]$/g, '');
    if (
        host === 'localhost' ||
        host.endsWith('.localhost') ||
        host.endsWith('.local') ||
        host === '::1' ||
        host.startsWith('fc') ||
        host.startsWith('fd') ||
        host.startsWith('fe80:') ||
        /^127\./.test(host) ||
        /^10\./.test(host) ||
        /^192\.168\./.test(host) ||
        /^169\.254\./.test(host) ||
        /^172\.(1[6-9]|2[0-9]|3[01])\./.test(host) ||
        /^0\./.test(host)
    ) {
        fail('Private, local and loopback network addresses cannot be imported.');
    }

    url.hash = '';
    return url;
}

function decodeEntities(value) {
    return value
        .replace(/&amp;/gi, '&')
        .replace(/&quot;/gi, '"')
        .replace(/&#39;|&apos;/gi, "'")
        .replace(/&lt;/gi, '<')
        .replace(/&gt;/gi, '>')
        .replace(/&#(\d+);/g, (_, code) => String.fromCodePoint(Number(code)))
        .replace(/&#x([\da-f]+);/gi, (_, code) => String.fromCodePoint(parseInt(code, 16)));
}

function extractTag(html, expression, attribute) {
    const match = html.match(expression);
    if (!match) return null;
    if (attribute) {
        const attrs = match[1] || '';
        const found = attrs.match(new RegExp('(?:^|\\s)' + attribute + '\\s*=\\s*(?:"([^"]*)"|\\'([^\\']*)\\'|([^\\s>]+))', 'i'));
        return found ? decodeEntities(found[1] || found[2] || found[3] || '').trim() : null;
    }
    return decodeEntities(match[1].replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ')).trim();
}

function extractLinks(html, baseUrl) {
    const found = new Map();
    const expression = /<a\\b[^>]*?href\\s*=\\s*(?:"([^"]*)"|'([^']*)'|([^\\s>]+))[^>]*>/gi;
    let match;

    while ((match = expression.exec(html)) && found.size < MAX_LINKS) {
        const raw = decodeEntities(match[1] || match[2] || match[3] || '').trim();
        if (!raw || /^(?:#|javascript:|mailto:|tel:|data:)/i.test(raw)) continue;

        try {
            const target = new URL(raw, baseUrl);
            if (!['http:', 'https:'].includes(target.protocol)) continue;
            target.hash = '';
            found.set(target.href, {
                url: target.href,
                sameOrigin: target.origin === baseUrl.origin
            });
        } catch (error) {
            // Ignore malformed links without failing the site preview.
        }
    }

    return Array.from(found.values());
}

/**
 * Inspects a public website without copying or publishing its content.
 * Redirects are returned for explicit review rather than followed automatically.
 */
export async function previewWebsiteImport(address) {
    const target = validatePublicHttpUrl(address);
    let response;

    try {
        response = await fetch(target.href, {
            method: 'get',
            headers: {
                'Accept': 'text/html,application/xhtml+xml;q=0.9',
                'User-Agent': 'PeanutBrowsing-SiteImportPreview/1.0'
            },
            redirect: 'manual'
        });
    } catch (error) {
        fail('The website could not be reached. Check the address or try again later.');
    }

    const status = response.status;
    if (status >= 300 && status < 400) {
        const location = response.headers.get('location');
        let redirectUrl = null;

        if (location) {
            try {
                redirectUrl = validatePublicHttpUrl(new URL(location, target).href).href;
            } catch (error) {
                redirectUrl = null;
            }
        }

        return {
            status: 'redirect',
            sourceUrl: target.href,
            redirectUrl,
            message: redirectUrl
                ? 'The website redirects. Review the destination before continuing.'
                : 'The website returned a redirect that could not be safely followed.'
        };
    }

    if (!response.ok) {
        return {
            status: 'unavailable',
            sourceUrl: target.href,
            httpStatus: status,
            message: 'The website did not return a successful response.'
        };
    }

    const contentType = response.headers.get('content-type') || '';
    if (!/text\\/html|application\\/xhtml\\+xml/i.test(contentType)) {
        return {
            status: 'unsupported',
            sourceUrl: target.href,
            contentType,
            message: 'The address did not return an HTML website.'
        };
    }

    const declaredLength = Number(response.headers.get('content-length') || 0);
    if (declaredLength > MAX_HTML_BYTES) {
        fail('The website homepage exceeds the preview size limit.');
    }

    const html = await response.text();
    if (html.length > MAX_HTML_BYTES) {
        fail('The website homepage exceeds the preview size limit.');
    }

    const title = extractTag(html, /<title\\b[^>]*>([\\s\\S]*?)<\\/title>/i);
    const description = extractTag(html, /<meta\\b([^>]*)>/i, 'content');
    const canonical = (() => {
        const tags = html.match(/<link\\b[^>]*>/gi) || [];
        for (const tag of tags) {
            if (!/rel\\s*=\\s*["']?canonical/i.test(tag)) continue;
            const match = tag.match(/href\\s*=\\s*(?:"([^"]*)"|'([^']*)'|([^\\s>]+))/i);
            if (match) {
                try {
                    return validatePublicHttpUrl(new URL(decodeEntities(match[1] || match[2] || match[3]), target).href).href;
                } catch (error) {
                    return null;
                }
            }
        }
        return null;
    })();

    const links = extractLinks(html, target);
    return {
        status: 'preview',
        sourceUrl: target.href,
        finalUrl: target.href,
        title,
        description,
        canonicalUrl: canonical,
        language: extractTag(html, /<html\\b([^>]*)>/i, 'lang'),
        pageTitleFound: Boolean(title),
        linkCount: links.length,
        sameOriginLinkCount: links.filter(link => link.sameOrigin).length,
        externalLinkCount: links.filter(link => !link.sameOrigin).length,
        links,
        message: 'Website preview created. No content has been copied, stored or published.'
    };
}
