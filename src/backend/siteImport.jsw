import { fetch } from 'wix-fetch';
import { validatePublicWebsiteUrl } from 'backend/searchUtils';
import { attribute, collectLinks, decodeHtml, metaContent } from 'backend/siteImportUtils';

const MAX_HTML_CHARS = 2 * 1024 * 1024;

function reject(message) {
    throw new Error(message);
}

function publicHttpUrl(value) {
    try {
        return new URL(validatePublicWebsiteUrl(value));
    } catch (error) {
        reject(error && error.message ? error.message : 'Only public HTTP or HTTPS websites can be imported.');
    }
}

/**
 * Creates a read-only preview of a public website.
 * Redirects are surfaced for review and are never followed automatically.
 */
export async function previewWebsiteImport(address) {
    const source = publicHttpUrl(address);
    let response;
    try {
        response = await fetch(source.href, {
            method: 'get',
            headers: { Accept: 'text/html,application/xhtml+xml;q=0.9' },
            redirect: 'manual'
        });
    } catch (error) {
        reject('The website could not be reached. Check the address or try again later.');
    }

    if (response.status >= 300 && response.status < 400) {
        const location = response.headers.get('location');
        let destination = null;
        if (location) {
            try {
                destination = publicHttpUrl(new URL(location, source).href).href;
            } catch (error) {
                destination = null;
            }
        }
        return {
            status: 'redirect',
            sourceUrl: source.href,
            redirectUrl: destination,
            message: destination ? 'Review the redirect destination before continuing.' : 'The redirect destination is not permitted.'
        };
    }

    if (!response.ok) return { status: 'unavailable', sourceUrl: source.href, httpStatus: response.status };

    const contentType = response.headers.get('content-type') || '';
    if (!/text\/html|application\/xhtml\+xml/i.test(contentType)) {
        return { status: 'unsupported', sourceUrl: source.href, contentType };
    }

    const length = Number(response.headers.get('content-length') || 0);
    if (length > MAX_HTML_CHARS) reject('The homepage exceeds the preview size limit.');
    const html = await response.text();
    if (html.length > MAX_HTML_CHARS) reject('The homepage exceeds the preview size limit.');

    const titleMatch = html.match(/<title\b[^>]*>([\s\S]*?)<\/title>/i);
    const title = titleMatch ? decodeHtml(titleMatch[1].replace(/<[^>]*>/g, ' ').trim()) : null;
    const links = collectLinks(html, source);
    const canonicalTag = (html.match(/<link\b[^>]*>/gi) || []).find(tag =>
        (attribute(tag, 'rel') || '').toLowerCase().split(/\s+/).includes('canonical')
    );
    let canonicalUrl = null;
    if (canonicalTag && attribute(canonicalTag, 'href')) {
        try {
            canonicalUrl = publicHttpUrl(new URL(attribute(canonicalTag, 'href'), source).href).href;
        } catch (error) {
            canonicalUrl = null;
        }
    }

    const htmlTag = (html.match(/<html\b[^>]*>/i) || [])[0] || '';
    return {
        status: 'preview',
        sourceUrl: source.href,
        title,
        description: metaContent(html, 'name', 'description') || metaContent(html, 'property', 'og:description'),
        canonicalUrl,
        language: attribute(htmlTag, 'lang'),
        linkCount: links.length,
        sameOriginLinkCount: links.filter(link => link.sameOrigin).length,
        externalLinkCount: links.filter(link => !link.sameOrigin).length,
        links,
        message: 'Preview generated. No website content has been copied, stored or published.'
    };
}
