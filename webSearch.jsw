import { fetch } from 'wix-fetch';
import { secrets } from 'wix-secrets-backend.v2';
import { elevate } from 'wix-auth';
import { normalizeSearchResults, normalizeTotalResults, validateSearchEndpoint, validateSearchRequest } from 'backend/searchUtils';

const elevatedGetSecretValue = elevate(secrets.getSecretValue);
const SEARCH_ENDPOINT_SECRET = 'PEANUT_SEARCH_API_URL';
const SEARCH_API_KEY_SECRET = 'PEANUT_SEARCH_API_KEY';

async function readSecret(name) {
    try {
        const value = await elevatedGetSecretValue(name);
        if (typeof value === 'string' && value.trim()) return value.trim();
        if (value && typeof value.value === 'string' && value.value.trim()) return value.value.trim();
    } catch (error) {
        throw new Error('Peanut Browsing first-party search is not connected yet.');
    }
    throw new Error('Peanut Browsing first-party search is not connected yet.');
}

/** Queries only Peanut Browsing's own index. No external search engines are called. */
export async function searchWeb(query, page) {
    const request = validateSearchRequest(query, page);
    const endpoint = validateSearchEndpoint(await readSecret(SEARCH_ENDPOINT_SECRET));
    const apiKey = await readSecret(SEARCH_API_KEY_SECRET);
    const url = new URL('/index/search', endpoint.origin);
    url.searchParams.set('q', request.query);
    url.searchParams.set('limit', '20');
    url.searchParams.set('offset', String((request.page - 1) * 20));

    let response;
    try {
        response = await fetch(url.href, {
            method: 'get',
            headers: { Accept: 'application/json', 'X-API-Key': apiKey }
        });
    } catch (error) {
        throw new Error('Peanut Browsing could not reach its first-party index. Try again shortly.');
    }
    if (!response.ok) {
        throw new Error('Peanut Browsing first-party index returned HTTP ' + response.status + '.');
    }

    let payload;
    try {
        payload = await response.json();
    } catch (error) {
        throw new Error('Peanut Browsing first-party index returned unreadable data.');
    }
    if (!payload || payload.status !== 'ok' || !Array.isArray(payload.results)) {
        throw new Error('Peanut Browsing first-party index returned an invalid results document.');
    }

    const results = normalizeSearchResults(payload.results.map(result => ({
        ...result,
        content: typeof result.snippet === 'string' ? result.snippet : ''
    })));
    const totalResults = normalizeTotalResults(payload.totalResults);
    return {
        status: 'ok',
        query: request.query,
        page: request.page,
        results,
        resultCount: results.length,
        totalResults,
        hasNextPage: totalResults === null
            ? results.length === 20
            : (request.page * 20) < totalResults
    };
}
